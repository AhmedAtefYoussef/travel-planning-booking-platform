# Copy to backend/.env and fill in real values. backend/.env is gitignored: never commit it,
# never paste it into chat or AI tools (brief sections 8.11 and 11.2d).
# The backend validates these at startup and refuses to boot if a required one is missing.

# --- Runtime ---
NODE_ENV=development
PORT=3000
# Comma-separated origins allowed to call the API with cookies (the Next.js app in Milestone 2)
CORS_ORIGINS=http://localhost:3001

# --- Database (shared team MongoDB Atlas cluster; replica set required for transactions) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/travel_platform?retryWrites=true&w=majority

# --- Auth & sessions (ACC-04, ACC-06, ACC-19) ---
# At least 32 random characters, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
SESSION_IDLE_MINUTES=30
# true behind HTTPS; false only for local http://localhost
COOKIE_SECURE=false
# Temporary stub auth (TRVL-131) until ACC-11 lands: accept an x-dev-user header. Ignored when NODE_ENV=production.
AUTH_STUB=true

# --- Payments (PAY-01..PAY-04; Stripe TEST mode keys only) ---
PLATFORM_CURRENCY=USD
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# --- Exchange rates (ITN-18; server-side only, never exposed to the frontend) ---
FX_API_KEY=replace_me
FX_API_BASE_URL=https://api.fxratesapi.com

# --- Uploads (GEN-08) ---
UPLOAD_DIR=./uploads

# --- Admin seed (ACC-18; admins cannot self-register) ---
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=ChangeMe!2026
