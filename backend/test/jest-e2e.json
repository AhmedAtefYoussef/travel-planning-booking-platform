{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "node_modules[/\\\\].+\\.js$": [
      "ts-jest",
      {
        "tsconfig": {
          "allowJs": true,
          "module": "commonjs",
          "esModuleInterop": true
        },
        "diagnostics": false
      }
    ],
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "globalSetup": "<rootDir>/support/global-setup.ts",
  "globalTeardown": "<rootDir>/support/global-teardown.ts",
  "setupFiles": ["<rootDir>/support/setup-env.ts"],
  "testTimeout": 30000,
  "transformIgnorePatterns": [
    "node_modules[/\\\\](?!(@noble|fontkit|brotli|dfa|unicode-properties|unicode-trie|linebreak|png-js|restructure)[/\\\\])(?!.*node_modules[/\\\\](@noble|fontkit|brotli|dfa|unicode-properties|unicode-trie|linebreak|png-js|restructure)[/\\\\])"
  ],
  "moduleNameMapper": {
    "^#binary-trie$": "<rootDir>/../node_modules/pdfkit/node_modules/unicode-properties/binaryTrie.browser.js"
  }
}
