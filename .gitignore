/uploads/
/backend/uploads/
/backend/uploads-test/

# Generated API spec (CI artifact)
backend/openapi.json

# Logs
*.log
npm-debug.log*

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
