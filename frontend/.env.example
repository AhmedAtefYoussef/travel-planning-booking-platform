# Copy to frontend/.env.local. Never commit real keys.

# Server-only: where the NestJS API runs. The browser reaches it same-origin through /api rewrites.
BACKEND_ORIGIN=http://localhost:3000

# Public site URL, used for SEO metadata (canonical URLs, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Stripe test-mode publishable key (pk_test_...). Safe to expose; the secret key stays in backend/.env.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
