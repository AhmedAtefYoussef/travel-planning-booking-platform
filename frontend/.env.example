# Copy to .env.local (git-ignored) and fill in. Never commit real values.

# Server-only: where Next.js forwards /api/* (rewrite) and sends server-side requests.
# The NestJS API runs on port 3000; this app runs on 3001.
BACKEND_URL=http://localhost:3000

# Browser: Stripe test-mode publishable key (pk_test_...) from the same Stripe account as the
# backend's STRIPE_SECRET_KEY. Publishable keys are safe in the browser; secret keys never are.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
