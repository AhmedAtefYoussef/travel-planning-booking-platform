{
  "name": "travel-platform-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Milestone 2 Next.js frontend for the Travel Planning and Booking Platform (App Router, TypeScript).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "api:types": "openapi-typescript ../docs/api/openapi.json -o src/shared/api/schema.d.ts --silent",
    "predev": "npm run api:types",
    "dev": "next dev --port 3001",
    "prebuild": "npm run api:types",
    "build": "next build",
    "start": "next start --port 3001",
    "prelint": "npm run api:types",
    "lint": "eslint --max-warnings 0",
    "pretypecheck": "npm run api:types",
    "typecheck": "next typegen && tsc --noEmit",
    "pretest": "npm run api:types",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.5",
    "@stripe/react-stripe-js": "7.0.1",
    "@stripe/stripe-js": "10.2.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "lucide-react": "1.70.0",
    "next": "16.4.6",
    "next-themes": "0.4.6",
    "openapi-fetch": "0.17.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.1.0"
  }
}
